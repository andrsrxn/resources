---
import Head from '@/components/Head.astro'
import '../styles/global.css'
import { Footer } from '@/components/footer'
---

<!doctype html>
<html lang='en' class='dark'>
  <Head />
  <body>
    <a
      href='#main-content'
      class='focus:bg-card sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-9999 focus:block focus:w-full focus:rounded-lg focus:border focus:border-white focus:px-4 focus:py-2 focus:text-center focus:text-base focus:font-medium focus:text-white focus:shadow-lg focus:outline-none'>
      Skip to main content
    </a>
    <slot />
    <Footer client:load />
    <script>
      import Lenis from 'lenis'

      const lenis = new Lenis({
        duration: 1.2,
      })

      function raf(time: number) {
        lenis.raf(time)
        requestAnimationFrame(raf)
      }

      requestAnimationFrame(raf)
    </script>
  </body>
</html>
